{
  "name": "@solo101/backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15"
  }
}
